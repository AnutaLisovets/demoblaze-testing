    {
      "name": "GET Products",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response time is less than 1000 ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);",
              "});",
              "",
              "pm.test(\"Response contains Items array\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.Items).to.be.an(\"array\");",
              "});",
              "",
              "pm.test(\"Items array is not empty\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.Items.length).to.be.above(0);",
              "});",
              "pm.test(\"Products array is not empty\", function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data.Items.length).to.be.above(0);",
              "});",
              "pm.test(\"First product has title\", function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data.Items[0]).to.have.property(\"title\");",
              "});",
              "pm.test(\"First product has price\", function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data.Items[0]).to.have.property(\"price\");",
              "});",
              "pm.test(\"Price is number\", function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data.Items[0].price).to.be.a(\"number\");",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
